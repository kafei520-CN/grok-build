<idea-plugin>
  <id>cn.mckafei.grok-build</id>
  <name>Grok Build By Kafei</name>
  <vendor url="https://github.com/kafei520-CN/Grok-For-VS-Code">kafei520cn</vendor>
  <description><![CDATA[Grok Build is an IntelliJ chat for the xAI Grok agent. It uses the same WebView UI and ACP grok agent stdio core as the VS Code extension, hosted with JCEF and a Node sidecar. Requires Node.js and the Grok CLI.
<p>IntelliJ 版 Grok Build：与 VS Code 插件共用同一套 WebView UI 和 Agent 核心。</p>
<ul>
  <li>Chat, login, API key, models, effort, Ask / Plan / Default modes</li>
  <li>Grok Diff review and revert</li>
  <li>Sessions, compact, rewind, fork, export, usage</li>
  <li>Rules, skills, MCP, agents, worktrees, memory, marketplace</li>
  <li>Add editor selection or the active file as context</li>
</ul>
]]></description>
  <change-notes><![CDATA[Grok Build By Kafei 0.1.97: compatibility range 2025.2–2026.3 (since-build 252, until-build 263.*).
<p>0.1.97 — Plugin Verifier: drop internal PluginManagerCore, deprecated ReadAction.compute, and override-only ActionGroup.getChildren.</p>
<p>0.1.96 — Pre-warm the Grok Diff browser so the first Review is a tab switch, not a JCEF cold start.</p>
<p>0.1.95 — Review clicks hop off the JCEF thread onto the EDT so Grok Diff can open.</p>
<p>0.1.94 — Grok Diff opens as a center editor tab; open-buffer reads/writes go through IntelliJ documents.</p>
<p>0.1.93 — Stop re-serializing the active file on every keystroke; coalesce JCEF stream paints.</p>
<p>0.1.92 — IntelliJ 2026.2: optional Web Browser (JCEF) dependency so the chat tool window can load.</p>
<p>0.1.89 — Marketplace Plugin Verifier: claim only the IntelliJ builds this binary is compiled against.</p>
<p>0.1.88 — Cancelled and leftover steps stay on the card and render muted instead of as errors.</p>
<p>0.1.87 — Full host rewrite: every VS Code command, live editor context, IntelliJ theme, status bar, settings, Grok Diff, terminal.</p>
]]></change-notes>
  <depends>com.intellij.modules.platform</depends>
  <depends optional="true" config-file="grok-jcef.xml">com.intellij.modules.jcef</depends>
  <depends optional="true" config-file="grok-terminal.xml">org.jetbrains.plugins.terminal</depends>
  <idea-version since-build="252" until-build="263.*"/>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Grok Build"
                anchor="right"
                icon="/icons/grok.svg"
                factoryClass="cn.mckafei.grokbuild.GrokToolWindowFactory"/>
    <notificationGroup id="Grok Build" displayType="BALLOON" isLogByDefault="true"/>
    <statusBarWidgetFactory id="GrokBuildWidget"
                            implementation="cn.mckafei.grokbuild.GrokStatusBarFactory"/>
    <applicationConfigurable parentId="tools"
                             id="cn.mckafei.grokbuild.settings"
                             instance="cn.mckafei.grokbuild.GrokConfigurable"
                             displayName="Grok Build"/>
    <fileType name="Grok Diff"
              implementationClass="cn.mckafei.grokbuild.GrokDiffFileType"
              fieldName="INSTANCE"/>
    <fileEditorProvider implementation="cn.mckafei.grokbuild.GrokDiffEditorProvider"/>
  </extensions>

  <actions>
    <group id="Grok.Menu" text="Grok Build" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="Grok.OpenChat"
              class="cn.mckafei.grokbuild.OpenChatAction"
              text="Open Grok Build"
              description="Focus the Grok Build tool window">
        <keyboard-shortcut keymap="$default" first-keystroke="control SEMICOLON"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta SEMICOLON"/>
      </action>
      <separator/>
      <action id="Grok.NewSession"
              class="cn.mckafei.grokbuild.NewSessionAction"
              text="New Session"
              description="Start a new Grok Build session"
              icon="AllIcons.General.Add"/>
      <action id="Grok.Resume"
              class="cn.mckafei.grokbuild.ResumeAction"
              text="Resume Session"
              description="Open the session list"
              icon="AllIcons.Vcs.History"/>
      <action id="Grok.Fork"
              class="cn.mckafei.grokbuild.ForkAction"
              text="Fork Session"
              description="Fork the current session"/>
      <action id="Grok.Export"
              class="cn.mckafei.grokbuild.ExportAction"
              text="Export Session"
              description="Export the current chat as Markdown"/>
      <separator/>
      <action id="Grok.Login"
              class="cn.mckafei.grokbuild.LoginAction"
              text="Login"
              description="Sign in to grok.com"/>
      <action id="Grok.Logout"
              class="cn.mckafei.grokbuild.LogoutAction"
              text="Logout"
              description="Sign out of Grok"/>
      <action id="Grok.SetApiKey"
              class="cn.mckafei.grokbuild.SetApiKeyAction"
              text="Set API Key"
              description="Sign in with an xAI API key"/>
      <separator/>
      <action id="Grok.AddSelection"
              class="cn.mckafei.grokbuild.AddSelectionAction"
              text="Add Selection"
              description="Attach the current editor selection">
        <keyboard-shortcut keymap="$default" first-keystroke="control alt G"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt G"/>
      </action>
      <action id="Grok.AddActiveFile"
              class="cn.mckafei.grokbuild.AddActiveFileAction"
              text="Add Active File"
              description="Attach the current editor file"/>
      <separator/>
      <action id="Grok.Cancel"
              class="cn.mckafei.grokbuild.CancelAction"
              text="Cancel"
              description="Cancel the current turn"
              icon="AllIcons.Actions.Suspend"/>
      <action id="Grok.Compact"
              class="cn.mckafei.grokbuild.CompactAction"
              text="Compact Context"
              description="Compact the conversation"/>
      <action id="Grok.Rewind"
              class="cn.mckafei.grokbuild.RewindAction"
              text="Rewind"
              description="Rewind the conversation"/>
      <action id="Grok.CycleMode"
              class="cn.mckafei.grokbuild.CycleModeAction"
              text="Cycle Mode"
              description="Cycle Ask / Plan / Default">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift SEMICOLON"/>
        <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift SEMICOLON"/>
      </action>
      <action id="Grok.Usage"
              class="cn.mckafei.grokbuild.UsageAction"
              text="Usage"
              description="Show session usage"/>
      <separator/>
      <action id="Grok.Restart"
              class="cn.mckafei.grokbuild.RestartAgentAction"
              text="Restart Agent"
              description="Restart the Grok agent"
              icon="AllIcons.Actions.Refresh"/>
      <action id="Grok.ShowLog"
              class="cn.mckafei.grokbuild.ShowLogAction"
              text="Show Log"
              description="Open the Grok Build log"/>
    </group>

    <group id="Grok.ToolWindowTitle">
      <reference ref="Grok.NewSession"/>
      <reference ref="Grok.Restart"/>
      <reference ref="Grok.Resume"/>
      <reference ref="Grok.Cancel"/>
    </group>

    <action id="Grok.AddSelection.Editor"
            class="cn.mckafei.grokbuild.AddSelectionAction"
            text="Grok: Add Selection"
            description="Attach the current editor selection">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action id="Grok.AddActiveFile.Editor"
            class="cn.mckafei.grokbuild.AddActiveFileAction"
            text="Grok: Add Active File"
            description="Attach the current editor file">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
