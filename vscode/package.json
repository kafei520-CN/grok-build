{
  "name": "grok-for-vs-code",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.80",
  "publisher": "kafei520cn",
  "author": "mckafei_CN",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kafei520-CN/grok-build",
  "repository": {
    "type": "git",
    "url": "https://github.com/kafei520-CN/grok-build.git"
  },
  "bugs": {
    "url": "https://github.com/kafei520-CN/grok-build/issues"
  },
  "private": false,
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "grok",
    "xai",
    "agent",
    "acp",
    "chat"
  ],
  "activationEvents": [
    "onView:grok.chat"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "grok.openChat",
        "title": "%command.openChat%",
        "category": "Grok Build",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "grok.newSession",
        "title": "%command.newSession%",
        "category": "Grok Build",
        "icon": "$(add)"
      },
      {
        "command": "grok.login",
        "title": "%command.login%",
        "category": "Grok Build"
      },
      {
        "command": "grok.logout",
        "title": "%command.logout%",
        "category": "Grok Build"
      },
      {
        "command": "grok.setApiKey",
        "title": "%command.setApiKey%",
        "category": "Grok Build"
      },
      {
        "command": "grok.addSelection",
        "title": "%command.addSelection%",
        "category": "Grok Build"
      },
      {
        "command": "grok.addActiveFile",
        "title": "%command.addActiveFile%",
        "category": "Grok Build"
      },
      {
        "command": "grok.addFiles",
        "title": "%command.addFiles%",
        "category": "Grok Build"
      },
      {
        "command": "grok.restartAgent",
        "title": "%command.restartAgent%",
        "category": "Grok Build"
      },
      {
        "command": "grok.showLog",
        "title": "%command.showLog%",
        "category": "Grok Build"
      },
      {
        "command": "grok.cancel",
        "title": "%command.cancel%",
        "category": "Grok Build"
      },
      {
        "command": "grok.compact",
        "title": "%command.compact%",
        "category": "Grok Build"
      },
      {
        "command": "grok.rewind",
        "title": "%command.rewind%",
        "category": "Grok Build"
      },
      {
        "command": "grok.resumeSession",
        "title": "%command.resumeSession%",
        "category": "Grok Build"
      },
      {
        "command": "grok.cycleMode",
        "title": "%command.cycleMode%",
        "category": "Grok Build"
      },
      {
        "command": "grok.forkSession",
        "title": "%command.forkSession%",
        "category": "Grok Build"
      },
      {
        "command": "grok.exportSession",
        "title": "%command.exportSession%",
        "category": "Grok Build"
      },
      {
        "command": "grok.usage",
        "title": "%command.usage%",
        "category": "Grok Build"
      }
    ],
    "keybindings": [
      {
        "command": "grok.openChat",
        "key": "ctrl+;",
        "mac": "cmd+;"
      },
      {
        "command": "grok.addSelection",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorHasSelection"
      },
      {
        "command": "grok.cycleMode",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "grok.newSession",
          "when": "view == grok.chat",
          "group": "navigation"
        },
        {
          "command": "grok.restartAgent",
          "when": "view == grok.chat",
          "group": "navigation"
        },
        {
          "command": "grok.resumeSession",
          "when": "view == grok.chat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "grok.addSelection",
          "when": "editorHasSelection",
          "group": "grok@1"
        }
      ],
      "explorer/context": [
        {
          "command": "grok.addFiles",
          "group": "grok@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grok",
          "title": "%view.container%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "grok": [
        {
          "type": "webview",
          "id": "grok.chat",
          "name": "%view.chat%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "grok.cliPath": {
          "type": "string",
          "default": "",
          "description": "%config.cliPath%"
        },
        "grok.preferWorkspaceBinary": {
          "type": "boolean",
          "default": false,
          "description": "%config.preferWorkspaceBinary%"
        },
        "grok.minCliVersion": {
          "type": "string",
          "default": "0.1.0",
          "description": "%config.minCliVersion%"
        },
        "grok.permissionMode": {
          "type": "string",
          "enum": [
            "ask",
            "acceptEdits",
            "auto"
          ],
          "enumDescriptions": [
            "%config.permissionMode.ask%",
            "%config.permissionMode.acceptEdits%",
            "%config.permissionMode.auto%"
          ],
          "default": "ask",
          "description": "%config.permissionMode%"
        },
        "grok.includeSelectionOnSend": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeSelectionOnSend%"
        },
        "grok.alwaysApprove": {
          "type": "boolean",
          "default": false,
          "description": "%config.alwaysApprove%"
        },
        "grok.notifySound": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifySound%"
        },
        "grok.locale": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "enumDescriptions": [
            "%config.locale.auto%",
            "%config.locale.en%",
            "%config.locale.zhCN%"
          ],
          "default": "auto",
          "description": "%config.locale%"
        },
        "grok.termEncoding": {
          "type": "string",
          "enum": [
            "utf-8",
            "gbk",
            "gb18030",
            "gb2312",
            "big5",
            "shift_jis",
            "windows-1252",
            "iso-8859-1"
          ],
          "enumDescriptions": [
            "%config.termEncoding.utf8%",
            "%config.termEncoding.gbk%",
            "%config.termEncoding.gb18030%",
            "%config.termEncoding.gb2312%",
            "%config.termEncoding.big5%",
            "%config.termEncoding.shiftJis%",
            "%config.termEncoding.windows1252%",
            "%config.termEncoding.latin1%"
          ],
          "default": "utf-8",
          "description": "%config.termEncoding%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node esbuild.mjs --test && node --test dist/test/**/*.js",
    "package": "node ./scripts/package-vsix.cjs",
    "package:web": "node ./scripts/package-web.cjs"
  },
  "devDependencies": {
    "@shikijs/monaco": "^4.4.3",
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.25.4",
    "monaco-editor": "^0.52.2",
    "shiki": "^4.4.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "katex": "^0.18.7"
  }
}
